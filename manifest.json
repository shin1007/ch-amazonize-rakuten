{
  "manifest_version": 3,
  "default_locale": "ja",
  "name": "__MSG_appName__",
  "version": "2026.10.2",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "optional_permissions": ["notifications"],
  "host_permissions": [
    "https://*.rakuten.co.jp/*",
    "https://www.amazon.co.jp/*",
    "https://amazon-rakuten-link.shin1007.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "__MSG_appName__"
  },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.co.jp/*"],
      "js": ["src/lib/settings.js", "src/lib/health.js", "src/lib/i18n-data.js", "src/lib/i18n.js", "src/lib/amazon-slot.js", "src/content/amazon-link-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.amazon.co.jp/*"],
      "js": ["src/content/amazon-link.js", "src/content/amazon-wishlist.js", "src/content/amazon-product.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://store.shopping.yahoo.co.jp/*"],
      "js": ["src/lib/settings.js", "src/lib/health.js", "src/lib/i18n-data.js", "src/lib/i18n.js", "src/lib/dom.js", "src/lib/amazon-match.js", "src/content/item-amazon.js", "src/content/yahoo-item.js"],
      "css": ["src/styles/amazon.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://shopping.yahoo.co.jp/search*", "https://shopping.yahoo.co.jp/category/*"],
      "js": ["src/lib/settings.js", "src/lib/health.js", "src/content/yahoo-search.js"],
      "css": ["src/styles/yahoo.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.rakuten.co.jp/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/content/boot.js",
        "src/content/top.js"
      ],
      "css": ["src/styles/common.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://item.rakuten.co.jp/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/lib/coupon-model.js",
        "src/lib/amazon-match.js",
        "src/content/boot.js",
        "src/content/item-images.js",
        "src/content/item-gallery.js",
        "src/content/item-coupons.js",
        "src/content/item.js",
        "src/content/item-amazon.js"
      ],
      "css": ["src/styles/common.css", "src/styles/item.css", "src/styles/amazon.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://search.rakuten.co.jp/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/content/boot.js",
        "src/content/search.js"
      ],
      "css": ["src/styles/common.css", "src/styles/cart.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://cart.step.rakuten.co.jp/*",
        "https://*.basket.step.rakuten.co.jp/*",
        "https://basket.step.rakuten.co.jp/*",
        "https://step.item.rakuten.co.jp/*",
        "https://order.step.rakuten.co.jp/*"
      ],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/lib/coupon-model.js",
        "src/content/boot.js",
        "src/content/cart.js",
        "src/content/checkout.js"
      ],
      "css": ["src/styles/common.css", "src/styles/cart.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://order.my.rakuten.co.jp/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/content/boot.js",
        "src/content/orders.js"
      ],
      "css": ["src/styles/common.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://coupon.rakuten.co.jp/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/content/boot.js",
        "src/content/coupon.js"
      ],
      "css": ["src/styles/common.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://event.rakuten.co.jp/*"],
      "js": [
        "src/lib/settings.js",
        "src/lib/health.js",
        "src/lib/i18n-data.js",
        "src/lib/i18n.js",
        "src/lib/dom.js",
        "src/content/boot.js",
        "src/content/campaign.js"
      ],
      "css": ["src/styles/common.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://cart.step.rakuten.co.jp/*"
      ],
      "js": ["src/content/state-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://item.rakuten.co.jp/*"
      ],
      "js": ["src/content/video-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
